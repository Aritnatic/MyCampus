PORT=4000
# 'production' turns on the startup safety checks (see DEPLOY.md). Leave as development locally.
NODE_ENV=development
# Required in production, at least 32 characters. In development a random secret is generated into data/jwt.secret.
JWT_SECRET=
# Comma-separated list of allowed browser origins. Must not be * in production.
CORS_ORIGIN=*
# Password given to every seeded demo account by `npm run seed`. Dev only; production never seeds demo accounts.
SEED_PASSWORD=campus123
# Where the database, uploaded notes and backups live (default ./data). In production mount a persistent disk here.
DATA_DIR=
# 'console' prints sign-up/reset codes to the log and returns them from the API (dev only). Production needs 'resend'.
MAIL_PROVIDER=console
MAIL_FROM=MyCampus <no-reply@your-domain>
RESEND_API_KEY=
# Set to 1 to deliver push notifications through Expo's push service.
EXPO_PUSH=0
# Folder holding the built admin panel; if set, the API serves it at / (the Docker image sets this).
ADMIN_DIR=
# One JSON log line per request. Defaults to on in production.
LOG_REQUESTS=
# Per-IP cap on sign-in/sign-up calls per 15 minutes. A campus shares one public IP, so keep this high.
AUTH_IP_LIMIT=600
# Automatic backups (hours between; 0 = off, default 24 in production) and how many to keep.
BACKUP_EVERY_HOURS=
BACKUP_KEEP=14
